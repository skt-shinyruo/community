    "src/utils/opaqueId.js",
    "src/utils/safeJson.js",
    "src/utils/scrollToAnchor.js",
    "src/utils/settledRequests.js",
    "src/utils/time.js",

    // Authentication and HTTP recovery
    "src/api/authenticatedHttp.js",
    "src/api/http.js",
    "src/api/imCoreHttp.js",
    "src/api/services/authService.js",
    "src/auth/refreshCoordinator.js",
    "src/auth/refreshTransport.js",
    "src/auth/session.js",
    "src/stores/app.js",
    "src/stores/auth.js",

